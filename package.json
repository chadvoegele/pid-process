{
	"name": "pid-process",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"exports": "./dist/index.js",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
		"lint": "biome lint src tests",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"test": "npm run test:unit && npm run test:e2e",
		"test:e2e": "node --test tests/test_*.e2e.mjs",
		"test:unit": "node --test tests/*.test.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.8",
		"@earendil-works/chord": "1.5.2",
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-durable": "1.5.2",
		"@types/node": "26.0.0",
		"typescript": "6.0.2"
	}
}
